<?xml version="1.0" encoding="utf-8"?>
<Installation Product="ArcGISPro" Version="3.6">
  <RegFree>True</RegFree>
  <DisplayVersion stem="ArcGIS Pro 3.6.0" showBuild="false" />
  <ExecutableName>ArcGISPro.exe</ExecutableName>
  <DisplayName>ArcGIS Pro</DisplayName>
  <ApplicationLangIdKey>ARCGISPRO_UILANGID</ApplicationLangIdKey>
  <DictionaryLangIdKey>ARCGISPRO_DICTIONARYLANGID</DictionaryLangIdKey>
  <AGOLConfig>
    <UserAgent>ArcGISPro</UserAgent>
    <OAuthAppId>arcgispro</OAuthAppId>
    <OAuthAppIdLicensing>arcgisprodesktop</OAuthAppIdLicensing>
    <PortalRegKey>ArcGIS Online For Pro</PortalRegKey>
  </AGOLConfig>
  <HelpConfig>
    <HelpWebUrl>https://pro.arcgis.com</HelpWebUrl>
    <HelpDefaultStartPage>pro-app/help</HelpDefaultStartPage>
    <OnlineHelpLangIdKey>ARCGISPRO_ONLINEHELPLANGID</OnlineHelpLangIdKey>
    <OfflineHelpLangIdKey>ARCGISPRO_OFFLINEHELPLANGID</OfflineHelpLangIdKey>
    <OfflineHelpKey>ArcGIS Pro Help</OfflineHelpKey>
  </HelpConfig>
</Installation>